class Solution {
    public List<Integer> solveQueries(int[] a, int[] q) {
        int n = a.length;
        Map<Integer, List<Integer>> pos = new HashMap<>();

        for (int i = 0; i < n; i++) {
            pos.computeIfAbsent(a[i], k -> new ArrayList<>()).add(i);
        }

        for (List<Integer> idx : pos.values()) {
            Collections.sort(idx);
        }

        List<Integer> res = new ArrayList<>();

        for (int i : q) {
            int v = a[i];
            List<Integer> idx = pos.get(v);

            if (idx.size() < 2) {
                res.add(-1);
                continue;
            }

            int p = Collections.binarySearch(idx, i);
            if (p < 0) p = -p - 1;

            int l = (p - 1 + idx.size()) % idx.size();
            int r = (p + 1) % idx.size();

            int lc = idx.get(l);
            int rc = idx.get(r);

            int dl = Math.abs(i - lc);
            int dr = Math.abs(i - rc);

            dl = Math.min(dl, n - dl);
            dr = Math.min(dr, n - dr);

            res.add(Math.min(dl, dr));
        }

        return res;
    }
}
