class Solution{
    public long kthSmallestProduct(int[] nums1,int[] nums2,long k){
        long low=-10000000000L,high=10000000000L;
        while(low<high){
            long mid=low+(high-low)/2;
            if(count(nums1,nums2,mid)>=k)high=mid;
            else low=mid+1;
        }
        return low;
    }

    private long count(int[] a,int[] b,long x){
        long cnt=0;
        int m=b.length;
        for(int i=0;i<a.length;i++){
            int v=a[i];
            if(v==0){
                if(x>=0)cnt+=m;
            }else if(v>0){
                int l=0,r=m-1;
                while(l<=r){
                    int mid=(l+r)/2;
                    if((long)v*b[mid]<=x)l=mid+1;
                    else r=mid-1;
                }
                cnt+=l;
            }else{
                int l=0,r=m-1;
                while(l<=r){
                    int mid=(l+r)/2;
                    if((long)v*b[mid]<=x)r=mid-1;
                    else l=mid+1;
                }
                cnt+=m-l;
            }
        }
        return cnt;
    }
}
